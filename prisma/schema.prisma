generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum PortfolioStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum SocialPlatform {
  TELEGRAM
  GITHUB
  LINKEDIN
  WEBSITE
  INSTAGRAM
  X
  EMAIL
  PHONE
}

model User {
  id             String               @id @default(cuid())
  name           String?
  username       String               @unique
  email          String               @unique
  emailVerified  DateTime?
  passwordHash   String?
  image          String?
  locale         String               @default("en")
  role           UserRole             @default(USER)
  profile        Profile?
  accounts       Account[]
  sessions       Session[]
  resetTokens    PasswordResetToken[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model Profile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  fullName           String?
  title              String?
  shortBio           String?
  about              String?
  location           String?
  mainStack          String?
  email              String?
  phone              String?
  telegram           String?
  github             String?
  linkedIn           String?
  website            String?
  photoUrl           String?
  availability       String?
  isFeatured         Boolean            @default(false)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills             Skill[]
  projects           Project[]
  experiences        Experience[]
  educations         Education[]
  certificates       Certificate[]
  socialLinks        SocialLink[]
  portfolioSettings  PortfolioSettings?
  contactSettings    ContactSettings?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model SkillCategory {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  sortOrder  Int      @default(0)
  skills     Skill[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Skill {
  id                 String         @id @default(cuid())
  profileId          String
  categoryId         String?
  name               String
  proficiency        String?
  yearsOfExperience  Int?
  isCore             Boolean        @default(false)
  sortOrder          Int            @default(0)
  profile            Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category           SkillCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Project {
  id                String         @id @default(cuid())
  profileId         String
  title             String
  slug              String
  shortDescription  String
  fullDescription   String?
  technologies      String         @default("")
  imageUrl          String?
  githubUrl         String?
  liveUrl           String?
  playStoreUrl      String?
  appStoreUrl       String?
  featured          Boolean        @default(false)
  sortOrder         Int            @default(0)
  profile           Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  gallery           ProjectImage[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([profileId, slug])
}

model ProjectImage {
  id         String   @id @default(cuid())
  projectId  String
  imageUrl   String
  altText    String?
  sortOrder  Int      @default(0)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Experience {
  id           String   @id @default(cuid())
  profileId    String
  company      String
  role         String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  currentRole  Boolean  @default(false)
  description  String
  sortOrder    Int      @default(0)
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Education {
  id           String   @id @default(cuid())
  profileId    String
  institution  String
  title        String
  yearLabel    String?
  description  String?
  sortOrder    Int      @default(0)
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Certificate {
  id            String   @id @default(cuid())
  profileId     String
  title         String
  issuer        String
  yearLabel     String?
  description   String?
  credentialUrl String?
  sortOrder     Int      @default(0)
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SocialLink {
  id         String         @id @default(cuid())
  profileId  String
  platform   SocialPlatform
  label      String?
  url        String
  sortOrder  Int            @default(0)
  profile    Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model PortfolioSettings {
  id                 String          @id @default(cuid())
  profileId          String          @unique
  status             PortfolioStatus @default(DRAFT)
  theme              String          @default("nocturne")
  accent             String          @default("cyan")
  seoTitle           String?
  seoDescription     String?
  showDiscover       Boolean         @default(true)
  showContactForm    Boolean         @default(true)
  spotlightText      String?
  profile            Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model ContactSettings {
  id                String   @id @default(cuid())
  profileId         String   @unique
  publicEmail       Boolean  @default(true)
  publicPhone       Boolean  @default(false)
  publicTelegram    Boolean  @default(true)
  allowContactForm  Boolean  @default(true)
  preferredLocale   String   @default("en")
  responseTime      String?
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
